{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/acciones/**",
              "components/cifras/**",
              "components/compartir/**",
              "components/formularios/**",
              "components/fuentes/**",
              "components/graficas/**",
              "components/iconos/**",
              "components/impresion/**",
              "components/narrativa/**",
              "ui_kits/micrositio/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color: use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value: use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bricolage Grotesque|Atkinson Hyperlegible Next|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Bricolage Grotesque, Atkinson Hyperlegible Next, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Boton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variante|tamano|icono|iconoFinal|disabled|completo|href|type|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Boton> doesn't accept that prop. Declared props: variante, tamano, icono, iconoFinal, disabled, completo, href, type, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Boton'] > JSXAttribute[name.name='variante'] > Literal[value!=/^(?:primario|secundario|texto)$/]",
        "message": "<Boton> variante must be one of 'primario' | 'secundario' | 'texto'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Boton'] > JSXAttribute[name.name='tamano'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Boton> tamano must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Boton'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Boton> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CampoEdad'] > JSXAttribute > JSXIdentifier[name!=/^(?:valor|onCambiar|min|max|etiqueta|ayuda|error|id|style|key|ref|className|style|children)$/]",
        "message": "<CampoEdad> doesn't accept that prop. Declared props: valor, onCambiar, min, max, etiqueta, ayuda, error, id, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CampoLuces'] > JSXAttribute > JSXIdentifier[name!=/^(?:forma|mostrarMapa|colorMapa|colorBordes|total|proporcion|encendidas|columnas|radio|separacion|semilla|orden|halo|animar|colorEncendida|colorApagada|etiqueta|style|key|ref|className|style|children)$/]",
        "message": "<CampoLuces> doesn't accept that prop. Declared props: forma, mostrarMapa, colorMapa, colorBordes, total, proporcion, encendidas, columnas, radio, separacion, semilla, orden, halo, animar, colorEncendida, colorApagada, etiqueta, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CampoLuces'] > JSXAttribute[name.name='forma'] > Literal[value!=/^(?:mexico|rejilla)$/]",
        "message": "<CampoLuces> forma must be one of 'mexico' | 'rejilla'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CampoLuces'] > JSXAttribute[name.name='orden'] > Literal[value!=/^(?:azar|lineal)$/]",
        "message": "<CampoLuces> orden must be one of 'azar' | 'lineal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CifraProtagonista'] > JSXAttribute > JSXIdentifier[name!=/^(?:valor|unidad|antetitulo|etiqueta|fuente|tamano|tono|animar|alinear|style|key|ref|className|style|children)$/]",
        "message": "<CifraProtagonista> doesn't accept that prop. Declared props: valor, unidad, antetitulo, etiqueta, fuente, tamano, tono, animar, alinear, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CifraProtagonista'] > JSXAttribute[name.name='tamano'] > Literal[value!=/^(?:display|cifra)$/]",
        "message": "<CifraProtagonista> tamano must be one of 'display' | 'cifra'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CifraProtagonista'] > JSXAttribute[name.name='tono'] > Literal[value!=/^(?:luz|texto|apagada)$/]",
        "message": "<CifraProtagonista> tono must be one of 'luz' | 'texto' | 'apagada'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CifraProtagonista'] > JSXAttribute[name.name='alinear'] > Literal[value!=/^(?:inicio|centro)$/]",
        "message": "<CifraProtagonista> alinear must be one of 'inicio' | 'centro'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FichaImprimible'] > JSXAttribute > JSXIdentifier[name!=/^(?:municipio|estado|anio|participacionJoven|participacionTotal|participacionEstado|participacionNacional|porEdad|seccionAlta|seccionBaja|preguntas|url|qrSrc|escala|style|key|ref|className|style|children)$/]",
        "message": "<FichaImprimible> doesn't accept that prop. Declared props: municipio, estado, anio, participacionJoven, participacionTotal, participacionEstado, participacionNacional, porEdad, seccionAlta, seccionBaja, preguntas, url, qrSrc, escala, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SerieEdad'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|nombre|puntos|tono|punteada|etiquetaFinal|key|ref|className|style|children)$/]",
        "message": "<SerieEdad> doesn't accept that prop. Declared props: id, nombre, puntos, tono, punteada, etiquetaFinal."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icono'] > JSXAttribute > JSXIdentifier[name!=/^(?:nombre|tamano|grosor|titulo|style|key|ref|className|style|children)$/]",
        "message": "<Icono> doesn't accept that prop. Declared props: nombre, tamano, grosor, titulo, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MapaEstados'] > JSXAttribute > JSXIdentifier[name!=/^(?:valores|escala|dominio|promedio|rango|formato|seleccionado|onSeleccionar|etiquetaLeyenda|mostrarLeyenda|style|key|ref|className|style|children)$/]",
        "message": "<MapaEstados> doesn't accept that prop. Declared props: valores, escala, dominio, promedio, rango, formato, seleccionado, onSeleccionar, etiquetaLeyenda, mostrarLeyenda, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='MapaEstados'] > JSXAttribute[name.name='escala'] > Literal[value!=/^(?:secuencial|divergente)$/]",
        "message": "<MapaEstados> escala must be one of 'secuencial' | 'divergente'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NotaMetodologica'] > JSXAttribute > JSXIdentifier[name!=/^(?:titulo|abierta|children|style|key|ref|className|style|children)$/]",
        "message": "<NotaMetodologica> doesn't accept that prop. Declared props: titulo, abierta, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PasoScrolly'] > JSXAttribute > JSXIdentifier[name!=/^(?:numero|antetitulo|activo|alineacion|children|style|key|ref|className|style|children)$/]",
        "message": "<PasoScrolly> doesn't accept that prop. Declared props: numero, antetitulo, activo, alineacion, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PasoScrolly'] > JSXAttribute[name.name='alineacion'] > Literal[value!=/^(?:izquierda|centro|derecha)$/]",
        "message": "<PasoScrolly> alineacion must be one of 'izquierda' | 'centro' | 'derecha'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PieFuente'] > JSXAttribute > JSXIdentifier[name!=/^(?:fuente|nota|enlace|style|key|ref|className|style|children)$/]",
        "message": "<PieFuente> doesn't accept that prop. Declared props: fuente, nota, enlace, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectorEstadoMunicipio'] > JSXAttribute > JSXIdentifier[name!=/^(?:estados|estado|municipio|onCambiar|direccion|style|key|ref|className|style|children)$/]",
        "message": "<SelectorEstadoMunicipio> doesn't accept that prop. Declared props: estados, estado, municipio, onCambiar, direccion, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectorEstadoMunicipio'] > JSXAttribute[name.name='direccion'] > Literal[value!=/^(?:columna|fila)$/]",
        "message": "<SelectorEstadoMunicipio> direccion must be one of 'columna' | 'fila'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectorSexo'] > JSXAttribute > JSXIdentifier[name!=/^(?:valor|onCambiar|opciones|etiqueta|ayuda|nombre|style|key|ref|className|style|children)$/]",
        "message": "<SelectorSexo> doesn't accept that prop. Declared props: valor, onCambiar, opciones, etiqueta, ayuda, nombre, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TarjetaWrapped'] > JSXAttribute > JSXIdentifier[name!=/^(?:variante|datos|escala|indice|total|fuente|style|key|ref|className|style|children)$/]",
        "message": "<TarjetaWrapped> doesn't accept that prop. Declared props: variante, datos, escala, indice, total, fuente, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TarjetaWrapped'] > JSXAttribute[name.name='variante'] > Literal[value!=/^(?:municipio|edad|generacion|secciones|cierre)$/]",
        "message": "<TarjetaWrapped> variante must be one of 'municipio' | 'edad' | 'generacion' | 'secciones' | 'cierre'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:tono|mensaje|accion|onCerrar|flotante|duracion|children|style|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: tono, mensaje, accion, onCerrar, flotante, duracion, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute[name.name='tono'] > Literal[value!=/^(?:info|exito|alerta)$/]",
        "message": "<Toast> tono must be one of 'info' | 'exito' | 'alerta'."
      }
    ]
  },
